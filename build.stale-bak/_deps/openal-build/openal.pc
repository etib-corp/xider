prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: OpenAL
Description: OpenAL is a cross-platform 3D audio API
Requires: 
Version: 1.25.2
Libs: -L${libdir} -lopenal 
Libs.private: -ldl -Wl,-framework,AudioToolbox -Wl,-framework,AudioUnit,-framework,ApplicationServices -Wl,-framework,CoreAudio -lm
Cflags: -I${includedir} -I${includedir}/AL -DAL_LIBTYPE_STATIC
